# ---- Access control -------------------------------------------------------
# Exactly the Google accounts allowed to sign in, comma-separated, exact match.
# The first address is "User 1" (Me), the second "User 2" (Wife).
ALLOWED_EMAILS=you@gmail.com,partner@gmail.com

# Auth.js
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Public URL of the deployment, e.g. https://household.up.railway.app
AUTH_URL=http://localhost:3000

# ---- Database -------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/household

# ---- Scheduled jobs -------------------------------------------------------
# Shared secret the Railway cron service sends as "Authorization: Bearer <secret>".
CRON_SECRET=generate-with-openssl-rand-base64-32

# ---- Finance: SimpleFIN ---------------------------------------------------
# Filled in once by the setup screen (setup token -> access URL).
SIMPLEFIN_ACCESS_URL=

# ---- AI providers (server-only; optional: keys can also be pasted in Settings, which win) ----
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Claude subscription (from `claude setup-token`); used before ANTHROPIC_API_KEY.
CLAUDE_CODE_OAUTH_TOKEN=

# Legal names to scrub from anything sent to an LLM, comma-separated.
HOUSEHOLD_LEGAL_NAMES=

# IANA time zone for the 7 AM / 7 PM bank sync slots.
HOUSEHOLD_TIMEZONE=America/New_York

# ---- Trips: documents vault ------------------------------------------------
# 32 random bytes, base64: openssl rand -base64 32
# Encrypts passport and ticket scans. Losing it makes stored files unreadable,
# and it cannot be rotated without re-encrypting. Without it, uploads are refused.
DOC_VAULT_KEY=

# ---- Assistant (MCP) endpoint ----------------------------------------------
# Off unless MCP_ENABLED=true. Uses AUTH_URL above as the OAuth issuer, so
# in production it must be the public https origin.
MCP_ENABLED=
# Extra OAuth redirect hosts beyond claude.ai, claude.com, chatgpt.com and
# oauth-redirect.googleusercontent.com, comma-separated. Usually empty.
MCP_EXTRA_REDIRECT_HOSTS=

# ---- Kitchen kiosk: Google Calendar (two-way) ------------------------------
# The kiosk and phones add, edit and delete events on the shared family
# calendar. It is found by name in the credential's calendar list ...
GOOGLE_CALENDAR_NAME="Pavel + Raisa"
# ... or given directly (required with a service account). Stays server-side.
GOOGLE_CALENDAR_ID=
# Optional label and colour for it on screen (defaults: the name, teal).
GOOGLE_CALENDAR_LABEL=
GOOGLE_CALENDAR_COLOR=
# Optional extra calendars, shown read-only, one per line or separated by ";":
#   Label|#hexcolour|calendar-id
# Example: Kids|#ea580c|abc@group.calendar.google.com
GOOGLE_CALENDARS=
# Credential, either an OAuth refresh token for one member's Google account
# with the scopes calendar.events and calendar.calendarlist.readonly ...
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# (GOOGLE_CLIENT_ID/SECRET fall back to AUTH_GOOGLE_ID/SECRET, and
# GOOGLE_CALENDAR_REFRESH_TOKEN still works as the old name.)
# ... or a service account JSON key (raw or base64). Share the calendar with
# its address with "Make changes to events" and set GOOGLE_CALENDAR_ID.
GOOGLE_CALENDAR_SERVICE_ACCOUNT=
